{
	"name": "ngx-cdk-lightbox",
	"description": "Custom implementation of CDK to display image gallery in lightbox.",
	"version": "1.0.0",
	"author": "miskith",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/miskith/ngx-cdk-lightbox/issues"
	},
	"homepage": "https://github.com/miskith/ngx-cdk-lightbox#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/miskith/ngx-cdk-lightbox.git"
	},
	"keywords": [
		"lightbox",
		"directives",
		"angular",
		"cdk"
	],
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build",
		"build:prod": "ng build ngx-cdk-lightbox --configuration production",
		"build:prod:demo": "ng build demo --configuration production",
		"test": "ng test --watch=false",
		"lint": "ng lint",
		"format": "prettier --config .prettierrc --write projects/**/*.{ts,json,md,scss}",
		"format:check": "prettier --config .prettierrc --check projects/**/*.{ts,json,md,scss}",
		"prepare": "husky"
	},
	"private": true,
	"dependencies": {
		"@angular/cdk": "^22.1.1",
		"@angular/common": "^22.1.0",
		"@angular/compiler": "^22.1.0",
		"@angular/core": "^22.1.0",
		"@angular/forms": "^22.1.0",
		"@angular/material": "^22.1.1",
		"@angular/platform-browser": "^22.1.0",
		"highlight.js": "^11.11.1",
		"ngx-highlightjs": "14.0.1",
		"rxjs": "~7.8.2",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@angular-eslint/builder": "^22.1.0",
		"@angular/build": "^22.1.3",
		"@angular/cli": "^22.1.3",
		"@angular/compiler-cli": "^22.1.0",
		"@angular/language-service": "^22.1.0",
		"@eslint/js": "^10.0.1",
		"@types/node": "~26.1.2",
		"angular-eslint": "^22.1.0",
		"baseline-browser-mapping": "^2.11.12",
		"eslint": "^10.8.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"husky": "^9.1.7",
		"jsdom": "^30.0.1",
		"ng-packagr": "^22.1.1",
		"prettier": "^3.9.6",
		"pretty": "^2.0.0",
		"ts-node": "^10.9.2",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.66.0",
		"vitest": "^4.1.10"
	}
}
